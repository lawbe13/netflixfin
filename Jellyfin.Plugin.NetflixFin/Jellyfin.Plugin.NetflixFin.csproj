<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.NetflixFin</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Pinned to the lowest release of the 10.11 line on purpose. Jellyfin resolves the
       shared libraries from the running server, so a plugin compiled against a *newer*
       Controller than the host refuses to load ("references an incompatible version of
       one of the shared libraries"). Building against the floor makes the plugin load on
       every 10.11.x. -->
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.0" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Web\netflixfin.css" />
    <EmbeddedResource Include="Web\netflixfin.js" />
    <!-- One station ident per channel, eight seconds each. Built from the
         server's own wordmark and a synthesised chord, so nothing here is
         downloaded or licensed. -->
    <EmbeddedResource Include="Web\tv\*.mp4" />
    <!-- One lockup per channel, drawn rather than set: the F and the
         channel's own tag, as vector. -->
    <EmbeddedResource Include="Web\tv\logos\*.svg" />
    <!-- The server's own wordmark and icons. They used to belong to another
         plugin, which is why the theme read the wordmark off the page rather
         than owning one; when that plugin went, so did the branding. -->
    <EmbeddedResource Include="Web\brand\*.png" />
    <EmbeddedResource Include="Web\brand\*.ico" />
  </ItemGroup>

</Project>
